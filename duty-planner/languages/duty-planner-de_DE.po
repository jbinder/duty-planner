#: includes/class-mailer.php:17
msgid ""
"Hi {name},\n"
"\n"
"thank you for signing up for \"{spot}\".\n"
"\n"
"Date: {date}\n"
"Time: {time}\n"
"Location: {location}\n"
"\n"
"We will send you a reminder beforehand.\n"
"Can't make it? Please cancel here so someone else can take over:\n"
"{cancel_url}\n"
"\n"
"Calendar: {calendar_url}"
msgstr "Hallo {name},\n\nvielen Dank, dass du dich für „{spot}“ eingetragen hast.\n\nDatum: {date}\nUhrzeit: {time}\nOrt: {location}\n\nWir schicken dir vorher eine Erinnerung.\nDu kannst doch nicht? Bitte trag dich hier aus, damit jemand anderes übernehmen kann:\n{cancel_url}\n\nKalender: {calendar_url}"

#: includes/class-mailer.php:21
msgid "Reminder: {spot} on {date}"
msgstr "Erinnerung: {spot} am {date}"

#: includes/class-mailer.php:22
msgid ""
"Hi {name},\n"
"\n"
"a friendly reminder that you are signed up for \"{spot}\".\n"
"\n"
"Date: {date}\n"
"Time: {time}\n"
"Location: {location}\n"
"\n"
"Can't make it after all? Please cancel here:\n"
"{cancel_url}\n"
"\n"
"Calendar: {calendar_url}"
msgstr "Hallo {name},\n\neine freundliche Erinnerung: Du bist für „{spot}“ eingetragen.\n\nDatum: {date}\nUhrzeit: {time}\nOrt: {location}\n\nDu kannst doch nicht? Bitte trag dich hier aus:\n{cancel_url}\n\nKalender: {calendar_url}"

